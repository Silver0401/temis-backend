{
  "name": "temis-backend",
  "description": "Temis backend api",
  "version": "1.1.4.7",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {
    "name": "Ismael Muñoz Contreras"
  },
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 22.2.0"
  },
  "feathers": {
    "language": "ts",
    "packager": "npm",
    "database": "mongodb",
    "framework": "koa",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "typebox"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "lib/client.js",
    "lib/**/*.d.ts",
    "lib/**/*.shared.js"
  ],
  "main": "lib/client",
  "scripts": {
    "dev": "env-cmd -f ./.env.dev nodemon -x ts-node src/index.ts",
    "prod": "env-cmd -f ./.env.prod nodemon -x ts-node src/index.ts",
    "build": "shx rm -rf lib/ && tsc",
    "start": "node lib/",
    "prettier": "npx prettier \"**/*.ts\" --write",
    "mocha": "cross-env NODE_ENV=test TS_NODE_PROJECT=test/tsconfig.json mocha test/ --require ts-node/register --recursive --extension .ts --exit",
    "test": "npm run mocha",
    "test:giis": "cross-env NODE_ENV=test mocha \"test/hooks/**/*.test.ts\" --require ts-node/register --extension .ts --exit",
    "bundle:client": "npm run compile && npm pack --pack-destination ./public",
    "admingen": "env-cmd -f ./.env.dev npx ts-node src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.882.0",
    "@aws-sdk/s3-request-presigner": "^3.882.0",
    "@feathersjs/adapter-commons": "^5.0.29",
    "@feathersjs/authentication": "^5.0.29",
    "@feathersjs/authentication-client": "^5.0.29",
    "@feathersjs/authentication-local": "^5.0.29",
    "@feathersjs/authentication-oauth": "^5.0.29",
    "@feathersjs/configuration": "^5.0.29",
    "@feathersjs/errors": "^5.0.29",
    "@feathersjs/express": "^5.0.33",
    "@feathersjs/feathers": "^5.0.29",
    "@feathersjs/koa": "^5.0.29",
    "@feathersjs/memory": "^5.0.37",
    "@feathersjs/mongodb": "^5.0.29",
    "@feathersjs/schema": "^5.0.29",
    "@feathersjs/socketio": "^5.0.29",
    "@feathersjs/transport-commons": "^5.0.29",
    "@feathersjs/typebox": "^5.0.29",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/koa-favicon": "^2.1.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.5.13",
    "axios": "^1.11.0",
    "cloudinary": "^2.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "koa-favicon": "^2.1.0",
    "mongodb": "^6.8.0",
    "openai": "^4.56.0",
    "shx": "^0.3.4",
    "socket.io": "^4.7.5",
    "winston": "^3.14.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@feathersjs/cli": "^5.0.29",
    "@feathersjs/rest-client": "^5.0.29",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
